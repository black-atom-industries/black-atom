<%
const s = theme.syntax;
const rules = [
  ["Comment", "comment, punctuation.definition.comment", s.comment.default],
  ["Doc comment", "comment.block.documentation", s.comment.doc],
  ["String", "string, punctuation.definition.string", s.string.default],
  ["String escape", "constant.character.escape", s.string.escape],
  ["Regexp", "string.regexp", s.string.regexp],
  ["Template expression", "punctuation.definition.template-expression, punctuation.section.embedded", s.punctuation.special],
  ["Number", "constant.numeric", s.number.default],
  ["Boolean", "constant.language.boolean", s.boolean.default],
  ["Builtin constant", "constant.language, support.constant", s.constant.builtin],
  ["Constant", "constant, variable.other.constant", s.constant.default],
  ["Keyword", "keyword, storage, storage.type, storage.modifier", s.keyword.default],
  ["Import", "keyword.control.import, keyword.control.from", s.keyword.import],
  ["Export", "keyword.control.export", s.keyword.export],
  ["Operator", "keyword.operator", s.operator.default],
  ["Variable", "variable, variable.other.readwrite", s.variable.default],
  ["Parameter", "variable.parameter", s.variable.parameter],
  ["Builtin variable", "variable.language", s.variable.builtin],
  ["Member", "variable.other.member, variable.other.object", s.variable.member],
  ["Property", "variable.other.property, variable.other.object.property, meta.object-literal.key, support.type.property-name, entity.name.tag.yaml", s.property.default],
  ["Function", "entity.name.function, meta.function-call, variable.function", s.func.default],
  ["Method", "meta.method-call, entity.name.function.method, meta.function-call.method", s.func.method],
  ["Builtin function", "support.function", s.func.builtin],
  ["Constructor", "entity.name.function.constructor, new.expr entity.name.type", s.constructor.default],
  ["Type", "entity.name.type, entity.name.class, entity.other.inherited-class, support.class", s.type.default],
  ["Builtin type", "support.type, storage.type.primitive, keyword.type", s.type.builtin],
  ["Module", "entity.name.namespace, entity.name.module, support.module", s.module.default],
  ["Attribute", "meta.attribute, meta.decorator, entity.name.function.decorator", s.attribute.default],
  ["Tag", "entity.name.tag", s.tag.default],
  ["Builtin tag", "entity.name.tag.html, support.class.component", s.tag.builtin],
  ["Tag attribute", "entity.other.attribute-name", s.tag.attribute],
  ["Tag delimiter", "punctuation.definition.tag", s.tag.delimiter],
  ["Punctuation", "punctuation", s.punctuation.default],
  ["Delimiter", "punctuation.separator, punctuation.terminator, punctuation.accessor", s.punctuation.delimiter],
  ["Bracket", "punctuation.section, punctuation.definition.block, punctuation.definition.parameters, meta.brace", s.punctuation.bracket],
  ["Heading", "markup.heading, entity.name.section", s.markup.heading.h1],
  ["Bold", "markup.bold", s.markup.strong, "bold"],
  ["Italic", "markup.italic", s.markup.italic, "italic"],
  ["Strikethrough", "markup.strikethrough", s.markup.strikethrough],
  ["Quote", "markup.quote", s.markup.quote],
  ["List", "markup.list, punctuation.definition.list", s.markup.list.default],
  ["Link", "markup.underline.link, string.other.link", s.markup.link],
  ["Inline code", "markup.raw, markup.inline.raw", s.markup.code.fg],
  ["Inserted", "markup.inserted", theme.ui.fg.add],
  ["Deleted", "markup.deleted", theme.ui.fg.delete],
  ["Changed", "markup.changed", theme.ui.fg.modify],
  ["Invalid", "invalid", theme.ui.fg.negative],
];
_%>
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom -->
<plist version="1.0">
<dict>
    <key>name</key>
    <string><%= theme.meta.label %></string>
    <key>settings</key>
    <array>
        <dict>
            <key>settings</key>
            <dict>
                <key>background</key>
                <string><%= theme.ui.bg.panel %></string>
                <key>foreground</key>
                <string><%= theme.ui.fg.default %></string>
                <key>caret</key>
                <string><%= theme.ui.fg.accent %></string>
                <key>selection</key>
                <string><%= theme.ui.bg.selection %></string>
                <key>lineHighlight</key>
                <string><%= theme.ui.bg.active %></string>
            </dict>
        </dict>
<% for (const [name, scope, color, fontStyle] of rules) { _%>
        <dict>
            <key>name</key>
            <string><%= name %></string>
            <key>scope</key>
            <string><%= scope %></string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string><%= color %></string>
<% if (fontStyle) { _%>
                <key>fontStyle</key>
                <string><%= fontStyle %></string>
<% } _%>
            </dict>
        </dict>
<% } _%>
    </array>
</dict>
</plist>
