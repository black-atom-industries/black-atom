# Black Atom — JPN ∷ Murasaki Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f1d9dd"
    minus-emph-style = syntax "#eec8c4"
    minus-empty-line-marker-style = normal "#f1d9dd"
    plus-style = syntax "#dce1e2"
    plus-emph-style = syntax "#c3d9ce"
    plus-empty-line-marker-style = normal "#dce1e2"

    line-numbers-minus-style = "#da534e"
    line-numbers-plus-style = "#349b76"
    line-numbers-zero-style = "#865f88"
    line-numbers-left-style = "#b796b8"
    line-numbers-right-style = "#b796b8"

    file-style = "#97a941" bold
    file-decoration-style = "#b796b8" ul
    hunk-header-decoration-style = "#b796b8" box
    hunk-header-line-number-style = "#4991a9"
