# Black Atom — JPN ∷ Murasaki Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ffd7e5"
    minus-emph-style = syntax "#ffd0cb"
    minus-empty-line-marker-style = normal "#ffd7e5"
    plus-style = syntax "#dfe4e8"
    plus-emph-style = syntax "#bee9d1"
    plus-empty-line-marker-style = normal "#dfe4e8"

    line-numbers-minus-style = "#c03b39"
    line-numbers-plus-style = "#007c50"
    line-numbers-zero-style = "#915495"
    line-numbers-left-style = "#ca86cd"
    line-numbers-right-style = "#ca86cd"

    file-style = "#97a941" bold
    file-decoration-style = "#ca86cd" ul
    hunk-header-decoration-style = "#ca86cd" box
    hunk-header-line-number-style = "#007498"
