# Black Atom — JPN ∷ Murasaki Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#fae4e8"
    minus-emph-style = syntax "#ffdeda"
    minus-empty-line-marker-style = normal "#fae4e8"
    plus-style = syntax "#d5ebe2"
    plus-emph-style = syntax "#b6edce"
    plus-empty-line-marker-style = normal "#d5ebe2"

    line-numbers-minus-style = "#c03b39"
    line-numbers-plus-style = "#007c50"
    line-numbers-zero-style = "#865f88"
    line-numbers-left-style = "#b796b8"
    line-numbers-right-style = "#b796b8"

    file-style = "#97a941" bold
    file-decoration-style = "#b796b8" ul
    hunk-header-decoration-style = "#b796b8" box
    hunk-header-line-number-style = "#007498"
