# Black Atom — JPN ∷ Tsuki Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#262223"
    minus-emph-style = syntax "#2f2729"
    minus-empty-line-marker-style = normal "#262223"
    plus-style = syntax "#212322"
    plus-emph-style = syntax "#262927"
    plus-empty-line-marker-style = normal "#212322"

    line-numbers-minus-style = "#f591b2"
    line-numbers-plus-style = "#90b99f"
    line-numbers-zero-style = "#9d9daf"
    line-numbers-left-style = "#4f4f61"
    line-numbers-right-style = "#4f4f61"

    file-style = "#eab899" bold
    file-decoration-style = "#4f4f61" ul
    hunk-header-decoration-style = "#4f4f61" box
    hunk-header-line-number-style = "#a1b0cf"
