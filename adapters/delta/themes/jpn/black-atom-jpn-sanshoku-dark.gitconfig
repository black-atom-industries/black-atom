# Black Atom — JPN ∷ Sanshoku Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#293a51"
    minus-emph-style = syntax "#353d52"
    minus-empty-line-marker-style = normal "#293a51"
    plus-style = syntax "#213d52"
    plus-emph-style = syntax "#244355"
    plus-empty-line-marker-style = normal "#213d52"

    line-numbers-minus-style = "#f86c59"
    line-numbers-plus-style = "#6fc483"
    line-numbers-zero-style = "#8ab2dc"
    line-numbers-left-style = "#4f759c"
    line-numbers-right-style = "#4f759c"

    file-style = "#f8ac3d" bold
    file-decoration-style = "#4f759c" ul
    hunk-header-decoration-style = "#4f759c" box
    hunk-header-line-number-style = "#76b1fc"
