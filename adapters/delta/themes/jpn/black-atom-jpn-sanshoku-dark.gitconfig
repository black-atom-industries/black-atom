# Black Atom — JPN ∷ Sanshoku Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#47404c"
    minus-emph-style = syntax "#704a49"
    minus-empty-line-marker-style = normal "#47404c"
    plus-style = syntax "#3c4c4d"
    plus-emph-style = syntax "#5b624b"
    plus-empty-line-marker-style = normal "#3c4c4d"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#6c93bc"
    line-numbers-left-style = "#5d84ac"
    line-numbers-right-style = "#5d84ac"

    file-style = "#f8ac3d" bold
    file-decoration-style = "#5d84ac" ul
    hunk-header-decoration-style = "#5d84ac" box
    hunk-header-line-number-style = "#79b5cc"
