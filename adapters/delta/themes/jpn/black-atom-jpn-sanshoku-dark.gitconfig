# Black Atom — JPN ∷ Sanshoku Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#4e424a"
    minus-emph-style = syntax "#7f4d44"
    minus-empty-line-marker-style = normal "#4e424a"
    plus-style = syntax "#355051"
    plus-emph-style = syntax "#4d6a53"
    plus-empty-line-marker-style = normal "#355051"

    line-numbers-minus-style = "#f86c59"
    line-numbers-plus-style = "#6fc483"
    line-numbers-zero-style = "#8ab2dc"
    line-numbers-left-style = "#6c93bc"
    line-numbers-right-style = "#6c93bc"

    file-style = "#f8ac3d" bold
    file-decoration-style = "#6c93bc" ul
    hunk-header-decoration-style = "#6c93bc" box
    hunk-header-line-number-style = "#76b1fc"
