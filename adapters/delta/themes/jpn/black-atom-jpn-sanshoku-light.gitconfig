# Black Atom — JPN ∷ Sanshoku Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#d4c5c5"
    minus-emph-style = syntax "#e5bab6"
    minus-empty-line-marker-style = normal "#d4c5c5"
    plus-style = syntax "#c3cdc2"
    plus-emph-style = syntax "#c2cbaf"
    plus-empty-line-marker-style = normal "#c3cdc2"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#4c5d67"
    line-numbers-left-style = "#617683"
    line-numbers-right-style = "#617683"

    file-style = "#cc8f00" bold
    file-decoration-style = "#617683" ul
    hunk-header-decoration-style = "#617683" box
    hunk-header-line-number-style = "#00a3e9"
