# Black Atom — JPN ∷ Sanshoku Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f5e8e8"
    minus-emph-style = syntax "#ffdfd8"
    minus-empty-line-marker-style = normal "#f5e8e8"
    plus-style = syntax "#d4efdf"
    plus-emph-style = syntax "#beecc6"
    plus-empty-line-marker-style = normal "#d4efdf"

    line-numbers-minus-style = "#cb3425"
    line-numbers-plus-style = "#1d7d3e"
    line-numbers-zero-style = "#768595"
    line-numbers-left-style = "#acb9c7"
    line-numbers-right-style = "#acb9c7"

    file-style = "#c47600" bold
    file-decoration-style = "#acb9c7" ul
    hunk-header-decoration-style = "#acb9c7" box
    hunk-header-line-number-style = "#2d6ebd"
