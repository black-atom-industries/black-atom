# Black Atom — JPN ∷ Sanshoku Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#cdc0c0"
    minus-emph-style = syntax "#d6b1ab"
    minus-empty-line-marker-style = normal "#cdc0c0"
    plus-style = syntax "#b8c8c2"
    plus-emph-style = syntax "#adc1b0"
    plus-empty-line-marker-style = normal "#b8c8c2"

    line-numbers-minus-style = "#db5241"
    line-numbers-plus-style = "#429c5a"
    line-numbers-zero-style = "#617683"
    line-numbers-left-style = "#7b919d"
    line-numbers-right-style = "#7b919d"

    file-style = "#cc8f00" bold
    file-decoration-style = "#7b919d" ul
    hunk-header-decoration-style = "#7b919d" box
    hunk-header-line-number-style = "#457ea1"
