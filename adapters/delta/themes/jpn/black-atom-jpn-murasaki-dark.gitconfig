# Black Atom — JPN ∷ Murasaki Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#553334"
    minus-emph-style = syntax "#754a45"
    minus-empty-line-marker-style = normal "#553334"
    plus-style = syntax "#3f3c3b"
    plus-emph-style = syntax "#485c53"
    plus-empty-line-marker-style = normal "#3f3c3b"

    line-numbers-minus-style = "#ff857b"
    line-numbers-plus-style = "#80bda2"
    line-numbers-zero-style = "#946996"
    line-numbers-left-style = "#865f88"
    line-numbers-right-style = "#865f88"

    file-style = "#dca23a" bold
    file-decoration-style = "#865f88" ul
    hunk-header-decoration-style = "#865f88" box
    hunk-header-line-number-style = "#8cb6c5"
