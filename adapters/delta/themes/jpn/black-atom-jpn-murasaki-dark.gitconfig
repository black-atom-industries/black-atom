# Black Atom — JPN ∷ Murasaki Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#40292c"
    minus-emph-style = syntax "#4b3734"
    minus-empty-line-marker-style = normal "#40292c"
    plus-style = syntax "#362d2f"
    plus-emph-style = syntax "#363f3b"
    plus-empty-line-marker-style = normal "#362d2f"

    line-numbers-minus-style = "#ff857b"
    line-numbers-plus-style = "#80bda2"
    line-numbers-zero-style = "#b386b5"
    line-numbers-left-style = "#9e76a0"
    line-numbers-right-style = "#9e76a0"

    file-style = "#d0e08d" bold
    file-decoration-style = "#9e76a0" ul
    hunk-header-decoration-style = "#9e76a0" box
    hunk-header-line-number-style = "#8cb6c5"
