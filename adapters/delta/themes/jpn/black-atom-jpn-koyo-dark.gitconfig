# Black Atom — JPN ∷ Koyo Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#2f1f2f"
    minus-emph-style = syntax "#382434"
    minus-empty-line-marker-style = normal "#2f1f2f"
    plus-style = syntax "#2b222f"
    plus-emph-style = syntax "#2f2933"
    plus-empty-line-marker-style = normal "#2b222f"

    line-numbers-minus-style = "#fe838f"
    line-numbers-plus-style = "#7fc08c"
    line-numbers-zero-style = "#b19b7c"
    line-numbers-left-style = "#59506a"
    line-numbers-right-style = "#59506a"

    file-style = "#e49e22" bold
    file-decoration-style = "#59506a" ul
    hunk-header-decoration-style = "#59506a" box
    hunk-header-line-number-style = "#b5a4d7"
