# Black Atom — JPN ∷ Koyo Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#4c303a"
    minus-emph-style = syntax "#714649"
    minus-empty-line-marker-style = normal "#4c303a"
    plus-style = syntax "#353a39"
    plus-emph-style = syntax "#445a48"
    plus-empty-line-marker-style = normal "#353a39"

    line-numbers-minus-style = "#fe838f"
    line-numbers-plus-style = "#7fc08c"
    line-numbers-zero-style = "#b19b7c"
    line-numbers-left-style = "#927c5f"
    line-numbers-right-style = "#927c5f"

    file-style = "#e49e22" bold
    file-decoration-style = "#927c5f" ul
    hunk-header-decoration-style = "#927c5f" box
    hunk-header-line-number-style = "#b5a4d7"
