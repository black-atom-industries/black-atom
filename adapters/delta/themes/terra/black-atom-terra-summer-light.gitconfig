# Black Atom — TERRA ∷ Summer Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ecdcd0"
    minus-emph-style = syntax "#e1cfc9"
    minus-empty-line-marker-style = normal "#ecdcd0"
    plus-style = syntax "#e4e1ca"
    plus-emph-style = syntax "#d0d8be"
    plus-empty-line-marker-style = normal "#e4e1ca"

    line-numbers-minus-style = "#ac6e59"
    line-numbers-plus-style = "#768c00"
    line-numbers-zero-style = "#26541c"
    line-numbers-left-style = "#506e2c"
    line-numbers-right-style = "#506e2c"

    file-style = "#c67b36" bold
    file-decoration-style = "#506e2c" ul
    hunk-header-decoration-style = "#506e2c" box
    hunk-header-line-number-style = "#5a8f65"
