# Black Atom — TERRA ∷ Summer Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f6e0d2"
    minus-emph-style = syntax "#f4d7cd"
    minus-empty-line-marker-style = normal "#f6e0d2"
    plus-style = syntax "#e9e6d0"
    plus-emph-style = syntax "#dae2c9"
    plus-empty-line-marker-style = normal "#e9e6d0"

    line-numbers-minus-style = "#a75235"
    line-numbers-plus-style = "#5f7400"
    line-numbers-zero-style = "#26541c"
    line-numbers-left-style = "#8fa58a"
    line-numbers-right-style = "#8fa58a"

    file-style = "#c67b36" bold
    file-decoration-style = "#8fa58a" ul
    hunk-header-decoration-style = "#8fa58a" box
    hunk-header-line-number-style = "#387848"
