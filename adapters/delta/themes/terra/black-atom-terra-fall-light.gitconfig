# Black Atom — TERRA ∷ Fall Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#eed1c3"
    minus-emph-style = syntax "#e4c4bf"
    minus-empty-line-marker-style = normal "#eed1c3"
    plus-style = syntax "#e1d6c6"
    plus-emph-style = syntax "#cacfc4"
    plus-empty-line-marker-style = normal "#e1d6c6"

    line-numbers-minus-style = "#bf4d3f"
    line-numbers-plus-style = "#6d7e57"
    line-numbers-zero-style = "#815137"
    line-numbers-left-style = "#9b6a4f"
    line-numbers-right-style = "#9b6a4f"

    file-style = "#d9710b" bold
    file-decoration-style = "#9b6a4f" ul
    hunk-header-decoration-style = "#9b6a4f" box
    hunk-header-line-number-style = "#956d57"
