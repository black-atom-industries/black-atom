# Black Atom — TERRA ∷ Fall Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#fcdecf"
    minus-emph-style = syntax "#ffdfd6"
    minus-empty-line-marker-style = normal "#fcdecf"
    plus-style = syntax "#e5e2bf"
    plus-emph-style = syntax "#d1e7b6"
    plus-empty-line-marker-style = normal "#e5e2bf"

    line-numbers-minus-style = "#af4125"
    line-numbers-plus-style = "#566b38"
    line-numbers-zero-style = "#815137"
    line-numbers-left-style = "#9b6a4f"
    line-numbers-right-style = "#9b6a4f"

    file-style = "#d9710b" bold
    file-decoration-style = "#9b6a4f" ul
    hunk-header-decoration-style = "#9b6a4f" box
    hunk-header-line-number-style = "#8c583b"
