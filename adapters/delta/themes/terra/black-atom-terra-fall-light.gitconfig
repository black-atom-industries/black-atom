# Black Atom — TERRA ∷ Fall Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ffdec9"
    minus-emph-style = syntax "#ffdfd6"
    minus-empty-line-marker-style = normal "#ffdec9"
    plus-style = syntax "#e8e2b9"
    plus-emph-style = syntax "#d1e7b6"
    plus-empty-line-marker-style = normal "#e8e2b9"

    line-numbers-minus-style = "#c45034"
    line-numbers-plus-style = "#566b38"
    line-numbers-zero-style = "#815136"
    line-numbers-left-style = "#b8a093"
    line-numbers-right-style = "#b8a093"

    file-style = "#c96600" bold
    file-decoration-style = "#b8a093" ul
    hunk-header-decoration-style = "#b8a093" box
    hunk-header-line-number-style = "#8c583b"
