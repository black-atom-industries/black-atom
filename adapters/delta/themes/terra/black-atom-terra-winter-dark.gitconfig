# Black Atom — TERRA ∷ Winter Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#241b20"
    minus-emph-style = syntax "#351f22"
    minus-empty-line-marker-style = normal "#241b20"
    plus-style = syntax "#112127"
    plus-emph-style = syntax "#0f2b31"
    plus-empty-line-marker-style = normal "#112127"

    line-numbers-minus-style = "#e996a0"
    line-numbers-plus-style = "#82c3d3"
    line-numbers-zero-style = "#6f8298"
    line-numbers-left-style = "#3f556b"
    line-numbers-right-style = "#3f556b"

    file-style = "#fba952" bold
    file-decoration-style = "#3f556b" ul
    hunk-header-decoration-style = "#3f556b" box
    hunk-header-line-number-style = "#7fb6ee"
