# Black Atom — TERRA ∷ Winter Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#372b30"
    minus-emph-style = syntax "#5b3f42"
    minus-empty-line-marker-style = normal "#372b30"
    plus-style = syntax "#253238"
    plus-emph-style = syntax "#384e53"
    plus-empty-line-marker-style = normal "#253238"

    line-numbers-minus-style = "#e996a0"
    line-numbers-plus-style = "#82c3d3"
    line-numbers-zero-style = "#6f8298"
    line-numbers-left-style = "#5e748b"
    line-numbers-right-style = "#5e748b"

    file-style = "#fba952" bold
    file-decoration-style = "#5e748b" ul
    hunk-header-decoration-style = "#5e748b" box
    hunk-header-line-number-style = "#7fb6ee"
