# Black Atom — TERRA ∷ Spring Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#2e2d2a"
    minus-emph-style = syntax "#4a393b"
    minus-empty-line-marker-style = normal "#2e2d2a"
    plus-style = syntax "#253227"
    plus-emph-style = syntax "#384336"
    plus-empty-line-marker-style = normal "#253227"

    line-numbers-minus-style = "#e9a6af"
    line-numbers-plus-style = "#a1cc98"
    line-numbers-zero-style = "#8ab091"
    line-numbers-left-style = "#2d5137"
    line-numbers-right-style = "#2d5137"

    file-style = "#a4dd98" bold
    file-decoration-style = "#2d5137" ul
    hunk-header-decoration-style = "#2d5137" box
    hunk-header-line-number-style = "#98c4e4"
