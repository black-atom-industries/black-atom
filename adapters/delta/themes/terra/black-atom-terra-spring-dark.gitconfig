# Black Atom — TERRA ∷ Spring Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#3d312e"
    minus-emph-style = syntax "#593d38"
    minus-empty-line-marker-style = normal "#3d312e"
    plus-style = syntax "#364338"
    plus-emph-style = syntax "#4b614d"
    plus-empty-line-marker-style = normal "#364338"

    line-numbers-minus-style = "#ba6e5f"
    line-numbers-plus-style = "#92d49a"
    line-numbers-zero-style = "#82978c"
    line-numbers-left-style = "#677e72"
    line-numbers-right-style = "#677e72"

    file-style = "#d1a762" bold
    file-decoration-style = "#677e72" ul
    hunk-header-decoration-style = "#677e72" box
    hunk-header-line-number-style = "#99b9e6"
