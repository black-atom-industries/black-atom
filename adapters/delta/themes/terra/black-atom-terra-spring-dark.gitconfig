# Black Atom — TERRA ∷ Spring Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#36302b"
    minus-emph-style = syntax "#623d40"
    minus-empty-line-marker-style = normal "#36302b"
    plus-style = syntax "#1e3927"
    plus-emph-style = syntax "#314e37"
    plus-empty-line-marker-style = normal "#1e3927"

    line-numbers-minus-style = "#f48993"
    line-numbers-plus-style = "#62bb77"
    line-numbers-zero-style = "#8ab091"
    line-numbers-left-style = "#658f6d"
    line-numbers-right-style = "#658f6d"

    file-style = "#d5e43f" bold
    file-decoration-style = "#658f6d" ul
    hunk-header-decoration-style = "#658f6d" box
    hunk-header-line-number-style = "#70afe3"
