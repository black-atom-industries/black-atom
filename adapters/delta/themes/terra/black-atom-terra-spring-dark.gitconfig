# Black Atom — TERRA ∷ Spring Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#362a24"
    minus-emph-style = syntax "#4f3634"
    minus-empty-line-marker-style = normal "#362a24"
    plus-style = syntax "#2b3023"
    plus-emph-style = syntax "#3a4232"
    plus-empty-line-marker-style = normal "#2b3023"

    line-numbers-minus-style = "#fb988f"
    line-numbers-plus-style = "#a8cb86"
    line-numbers-zero-style = "#be97b2"
    line-numbers-left-style = "#464a3b"
    line-numbers-right-style = "#464a3b"

    file-style = "#fb988f" bold
    file-decoration-style = "#464a3b" ul
    hunk-header-decoration-style = "#464a3b" box
    hunk-header-line-number-style = "#a6beef"
