# Black Atom — TERRA ∷ Spring Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#fbe7de"
    minus-emph-style = syntax "#fcddd9"
    minus-empty-line-marker-style = normal "#fbe7de"
    plus-style = syntax "#eceeda"
    plus-emph-style = syntax "#ddead2"
    plus-empty-line-marker-style = normal "#eceeda"

    line-numbers-minus-style = "#b13f3a"
    line-numbers-plus-style = "#4c730f"
    line-numbers-zero-style = "#626a4d"
    line-numbers-left-style = "#aeb2a4"
    line-numbers-right-style = "#aeb2a4"

    file-style = "#e66f66" bold
    file-decoration-style = "#aeb2a4" ul
    hunk-header-decoration-style = "#aeb2a4" box
    hunk-header-line-number-style = "#4964a3"
