# Black Atom — TERRA ∷ Spring Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ded5cf"
    minus-emph-style = syntax "#e8cec5"
    minus-empty-line-marker-style = normal "#ded5cf"
    plus-style = syntax "#cadcd0"
    plus-emph-style = syntax "#bfdbc7"
    plus-empty-line-marker-style = normal "#cadcd0"

    line-numbers-minus-style = "#dd7e5d"
    line-numbers-plus-style = "#11b066"
    line-numbers-zero-style = "#55816a"
    line-numbers-left-style = "#62937a"
    line-numbers-right-style = "#62937a"

    file-style = "#e49f1a" bold
    file-decoration-style = "#62937a" ul
    hunk-header-decoration-style = "#62937a" box
    hunk-header-line-number-style = "#588dc1"
