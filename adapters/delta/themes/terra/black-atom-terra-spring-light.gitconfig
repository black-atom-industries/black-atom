# Black Atom — TERRA ∷ Spring Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f7eae1"
    minus-emph-style = syntax "#ffdedf"
    minus-empty-line-marker-style = normal "#f7eae1"
    plus-style = syntax "#d7f0d4"
    plus-emph-style = syntax "#bfebc4"
    plus-empty-line-marker-style = normal "#d7f0d4"

    line-numbers-minus-style = "#bc4757"
    line-numbers-plus-style = "#008232"
    line-numbers-zero-style = "#3c744a"
    line-numbers-left-style = "#62946c"
    line-numbers-right-style = "#62946c"

    file-style = "#cede1c" bold
    file-decoration-style = "#62946c" ul
    hunk-header-decoration-style = "#62946c" box
    hunk-header-line-number-style = "#3574a4"
