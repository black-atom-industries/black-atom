# Black Atom — TERRA ∷ Winter Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#e0e2ef"
    minus-emph-style = syntax "#d4d4e8"
    minus-empty-line-marker-style = normal "#e0e2ef"
    plus-style = syntax "#d9e5eb"
    plus-emph-style = syntax "#c7dbe0"
    plus-empty-line-marker-style = normal "#d9e5eb"

    line-numbers-minus-style = "#6e6ab2"
    line-numbers-plus-style = "#208295"
    line-numbers-zero-style = "#4f667c"
    line-numbers-left-style = "#647d97"
    line-numbers-right-style = "#647d97"

    file-style = "#fa9916" bold
    file-decoration-style = "#647d97" ul
    hunk-header-decoration-style = "#647d97" box
    hunk-header-line-number-style = "#3578b8"
