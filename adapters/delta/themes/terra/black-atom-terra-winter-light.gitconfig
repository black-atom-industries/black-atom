# Black Atom — TERRA ∷ Winter Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#e8eafa"
    minus-emph-style = syntax "#e5e5ff"
    minus-empty-line-marker-style = normal "#e8eafa"
    plus-style = syntax "#caedf9"
    plus-emph-style = syntax "#a9eafd"
    plus-empty-line-marker-style = normal "#caedf9"

    line-numbers-minus-style = "#6964ac"
    line-numbers-plus-style = "#007a92"
    line-numbers-zero-style = "#4f667c"
    line-numbers-left-style = "#647d97"
    line-numbers-right-style = "#647d97"

    file-style = "#fa9916" bold
    file-decoration-style = "#647d97" ul
    hunk-header-decoration-style = "#647d97" box
    hunk-header-line-number-style = "#2c70af"
