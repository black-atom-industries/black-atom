# Black Atom — TERRA ∷ Winter Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#e5e7f7"
    minus-emph-style = syntax "#dfdff9"
    minus-empty-line-marker-style = normal "#e5e7f7"
    plus-style = syntax "#daecf3"
    plus-emph-style = syntax "#c9e8f1"
    plus-empty-line-marker-style = normal "#daecf3"

    line-numbers-minus-style = "#6964ac"
    line-numbers-plus-style = "#007a92"
    line-numbers-zero-style = "#4f667c"
    line-numbers-left-style = "#a4afba"
    line-numbers-right-style = "#a4afba"

    file-style = "#fa9916" bold
    file-decoration-style = "#a4afba" ul
    hunk-header-decoration-style = "#a4afba" box
    hunk-header-line-number-style = "#2c70af"
