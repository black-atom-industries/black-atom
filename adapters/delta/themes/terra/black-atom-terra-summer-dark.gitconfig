# Black Atom — TERRA ∷ Summer Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#1b1e1a"
    minus-emph-style = syntax "#352119"
    minus-empty-line-marker-style = normal "#1b1e1a"
    plus-style = syntax "#10231a"
    plus-emph-style = syntax "#1f2a19"
    plus-empty-line-marker-style = normal "#10231a"

    line-numbers-minus-style = "#c88f7b"
    line-numbers-plus-style = "#8cbf70"
    line-numbers-zero-style = "#94a585"
    line-numbers-left-style = "#2e503e"
    line-numbers-right-style = "#2e503e"

    file-style = "#d8bd51" bold
    file-decoration-style = "#2e503e" ul
    hunk-header-decoration-style = "#2e503e" box
    hunk-header-line-number-style = "#80be9d"
