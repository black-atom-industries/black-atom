# Black Atom — TERRA ∷ Fall Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#422822"
    minus-emph-style = syntax "#5f3933"
    minus-empty-line-marker-style = normal "#422822"
    plus-style = syntax "#332f26"
    plus-emph-style = syntax "#42473b"
    plus-empty-line-marker-style = normal "#332f26"

    line-numbers-minus-style = "#e87a69"
    line-numbers-plus-style = "#95a483"
    line-numbers-zero-style = "#c59174"
    line-numbers-left-style = "#b58266"
    line-numbers-right-style = "#b58266"

    file-style = "#d68c00" bold
    file-decoration-style = "#b58266" ul
    hunk-header-decoration-style = "#b58266" box
    hunk-header-line-number-style = "#d08c62"
