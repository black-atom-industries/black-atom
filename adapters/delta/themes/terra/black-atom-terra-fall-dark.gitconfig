# Black Atom — TERRA ∷ Fall Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#462e28"
    minus-emph-style = syntax "#67443e"
    minus-empty-line-marker-style = normal "#462e28"
    plus-style = syntax "#343128"
    plus-emph-style = syntax "#444a3e"
    plus-empty-line-marker-style = normal "#343128"

    line-numbers-minus-style = "#f69181"
    line-numbers-plus-style = "#95a483"
    line-numbers-zero-style = "#c59174"
    line-numbers-left-style = "#a98774"
    line-numbers-right-style = "#a98774"

    file-style = "#ce903a" bold
    file-decoration-style = "#a98774" ul
    hunk-header-decoration-style = "#a98774" box
    hunk-header-line-number-style = "#e2baa5"
