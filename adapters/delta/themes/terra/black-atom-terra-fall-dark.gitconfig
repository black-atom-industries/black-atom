# Black Atom — TERRA ∷ Fall Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#452b25"
    minus-emph-style = syntax "#663f39"
    minus-empty-line-marker-style = normal "#452b25"
    plus-style = syntax "#332f26"
    plus-emph-style = syntax "#42473b"
    plus-empty-line-marker-style = normal "#332f26"

    line-numbers-minus-style = "#fd8c7b"
    line-numbers-plus-style = "#95a483"
    line-numbers-zero-style = "#c59174"
    line-numbers-left-style = "#a98774"
    line-numbers-right-style = "#a98774"

    file-style = "#d68c00" bold
    file-decoration-style = "#a98774" ul
    hunk-header-decoration-style = "#a98774" box
    hunk-header-line-number-style = "#b2ae72"
