# Black Atom — Mono ∷ Dimmed Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#261b1b"
    minus-emph-style = syntax "#361f1f"
    minus-empty-line-marker-style = normal "#261b1b"
    plus-style = syntax "#1d2016"
    plus-emph-style = syntax "#242915"
    plus-empty-line-marker-style = normal "#1d2016"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#8c8c8c"
    line-numbers-left-style = "#5d5d5d"
    line-numbers-right-style = "#5d5d5d"

    file-style = "#d2b5bd" bold
    file-decoration-style = "#5d5d5d" ul
    hunk-header-decoration-style = "#5d5d5d" box
    hunk-header-line-number-style = "#79b5cc"
