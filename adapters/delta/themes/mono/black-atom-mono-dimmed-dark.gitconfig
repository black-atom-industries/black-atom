# Black Atom — Mono ∷ Dimmed Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#352424"
    minus-emph-style = syntax "#543131"
    minus-empty-line-marker-style = normal "#352424"
    plus-style = syntax "#2c2f24"
    plus-emph-style = syntax "#424832"
    plus-empty-line-marker-style = normal "#2c2f24"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#8c8c8c"
    line-numbers-left-style = "#7a7a7a"
    line-numbers-right-style = "#7a7a7a"

    file-style = "#d2b5bd" bold
    file-decoration-style = "#7a7a7a" ul
    hunk-header-decoration-style = "#7a7a7a" box
    hunk-header-line-number-style = "#79b5cc"
