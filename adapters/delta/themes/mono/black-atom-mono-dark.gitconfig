# Black Atom — Mono ∷ Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#301d1c"
    minus-emph-style = syntax "#502d2d"
    minus-empty-line-marker-style = normal "#301d1c"
    plus-style = syntax "#27291d"
    plus-emph-style = syntax "#3e442e"
    plus-empty-line-marker-style = normal "#27291d"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#82807d"
    line-numbers-left-style = "#4a4745"
    line-numbers-right-style = "#4a4745"

    file-style = "#e4e4e4" bold
    file-decoration-style = "#4a4745" ul
    hunk-header-decoration-style = "#4a4745" box
    hunk-header-line-number-style = "#79b5cc"
