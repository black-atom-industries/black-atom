# Black Atom — Mono ∷ Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#efdedd"
    minus-emph-style = syntax "#ffdedb"
    minus-empty-line-marker-style = normal "#efdedd"
    plus-style = syntax "#dae2c9"
    plus-emph-style = syntax "#d5e6b3"
    plus-empty-line-marker-style = normal "#dae2c9"

    line-numbers-minus-style = "#c21725"
    line-numbers-plus-style = "#5d7600"
    line-numbers-zero-style = "#525252"
    line-numbers-left-style = "#696969"
    line-numbers-right-style = "#696969"

    file-style = "#5f5155" bold
    file-decoration-style = "#696969" ul
    hunk-header-decoration-style = "#696969" box
    hunk-header-line-number-style = "#0079bd"
