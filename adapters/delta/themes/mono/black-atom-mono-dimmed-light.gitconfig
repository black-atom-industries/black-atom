# Black Atom — Mono ∷ Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#e9d3d1"
    minus-emph-style = syntax "#f3c7c3"
    minus-empty-line-marker-style = normal "#e9d3d1"
    plus-style = syntax "#d7dbcd"
    plus-emph-style = syntax "#cfd8bc"
    plus-empty-line-marker-style = normal "#d7dbcd"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#5d5d5d"
    line-numbers-left-style = "#8c8c8c"
    line-numbers-right-style = "#8c8c8c"

    file-style = "#5f5155" bold
    file-decoration-style = "#8c8c8c" ul
    hunk-header-decoration-style = "#8c8c8c" box
    hunk-header-line-number-style = "#00a3e9"
