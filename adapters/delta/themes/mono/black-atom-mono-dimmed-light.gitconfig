# Black Atom — Mono ∷ Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#e3d4d2"
    minus-emph-style = syntax "#e8c9c6"
    minus-empty-line-marker-style = normal "#e3d4d2"
    plus-style = syntax "#d6dacd"
    plus-emph-style = syntax "#cdd5bc"
    plus-empty-line-marker-style = normal "#d6dacd"

    line-numbers-minus-style = "#c21725"
    line-numbers-plus-style = "#5d7600"
    line-numbers-zero-style = "#525252"
    line-numbers-left-style = "#969696"
    line-numbers-right-style = "#969696"

    file-style = "#5f5155" bold
    file-decoration-style = "#969696" ul
    hunk-header-decoration-style = "#969696" box
    hunk-header-line-number-style = "#0079bd"
