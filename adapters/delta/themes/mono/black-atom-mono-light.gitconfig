# Black Atom — Mono ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#fff2ef"
    minus-emph-style = syntax "#ffe8e6"
    minus-empty-line-marker-style = normal "#fff2ef"
    plus-style = syntax "#f4f7e9"
    plus-emph-style = syntax "#eaf3d9"
    plus-empty-line-marker-style = normal "#f4f7e9"

    line-numbers-minus-style = "#c21725"
    line-numbers-plus-style = "#5d7600"
    line-numbers-zero-style = "#605d5b"
    line-numbers-left-style = "#b1afad"
    line-numbers-right-style = "#b1afad"

    file-style = "#2e2e2e" bold
    file-decoration-style = "#b1afad" ul
    hunk-header-decoration-style = "#b1afad" box
    hunk-header-line-number-style = "#0079bd"
