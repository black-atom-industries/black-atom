# Black Atom — Mono ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ffe9e5"
    minus-emph-style = syntax "#ffd6d1"
    minus-empty-line-marker-style = normal "#ffe9e5"
    plus-style = syntax "#eef1e1"
    plus-emph-style = syntax "#dee7ca"
    plus-empty-line-marker-style = normal "#eef1e1"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#8e8c89"
    line-numbers-left-style = "#b3b0ae"
    line-numbers-right-style = "#b3b0ae"

    file-style = "#2e2e2e" bold
    file-decoration-style = "#b3b0ae" ul
    hunk-header-decoration-style = "#b3b0ae" box
    hunk-header-line-number-style = "#00a3e9"
