# Black Atom — Mono ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ffedea"
    minus-emph-style = syntax "#ffdedb"
    minus-empty-line-marker-style = normal "#ffedea"
    plus-style = syntax "#eaf1d6"
    plus-emph-style = syntax "#d5e6b3"
    plus-empty-line-marker-style = normal "#eaf1d6"

    line-numbers-minus-style = "#c21725"
    line-numbers-plus-style = "#5d7600"
    line-numbers-zero-style = "#605d5b"
    line-numbers-left-style = "#82807d"
    line-numbers-right-style = "#82807d"

    file-style = "#2e2e2e" bold
    file-decoration-style = "#82807d" ul
    hunk-header-decoration-style = "#82807d" box
    hunk-header-line-number-style = "#0079bd"
