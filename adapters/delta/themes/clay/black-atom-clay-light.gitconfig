# Black Atom — Clay ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#fbe2d5"
    minus-emph-style = syntax "#fed2cd"
    minus-empty-line-marker-style = normal "#fbe2d5"
    plus-style = syntax "#e9ebd1"
    plus-emph-style = syntax "#d9e3c6"
    plus-empty-line-marker-style = normal "#e9ebd1"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#5d553f"
    line-numbers-left-style = "#79715a"
    line-numbers-right-style = "#79715a"

    file-style = "#e76b3e" bold
    file-decoration-style = "#79715a" ul
    hunk-header-decoration-style = "#79715a" box
    hunk-header-line-number-style = "#00a3e9"
