# Black Atom — Clay ∷ Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#4c3835"
    minus-emph-style = syntax "#674242"
    minus-empty-line-marker-style = normal "#4c3835"
    plus-style = syntax "#424436"
    plus-emph-style = syntax "#535943"
    plus-empty-line-marker-style = normal "#424436"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#a49e8d"
    line-numbers-left-style = "#868070"
    line-numbers-right-style = "#868070"

    file-style = "#fc8a61" bold
    file-decoration-style = "#868070" ul
    hunk-header-decoration-style = "#868070" box
    hunk-header-line-number-style = "#79b5cc"
