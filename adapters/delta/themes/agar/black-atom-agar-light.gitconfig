# Black Atom — AGAR ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ecdcd7"
    minus-emph-style = syntax "#efd0d6"
    minus-empty-line-marker-style = normal "#ecdcd7"
    plus-style = syntax "#dbe4d2"
    plus-emph-style = syntax "#cce0cb"
    plus-empty-line-marker-style = normal "#dbe4d2"

    line-numbers-minus-style = "#c82462"
    line-numbers-plus-style = "#1c882d"
    line-numbers-zero-style = "#929082"
    line-numbers-left-style = "#b1aea0"
    line-numbers-right-style = "#b1aea0"

    file-style = "#11ad32" bold
    file-decoration-style = "#b1aea0" ul
    hunk-header-decoration-style = "#b1aea0" box
    hunk-header-line-number-style = "#505fe4"
