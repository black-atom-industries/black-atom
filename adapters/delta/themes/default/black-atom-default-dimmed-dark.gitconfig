# Black Atom — Dimmed Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#332a2f"
    minus-emph-style = syntax "#462e33"
    minus-empty-line-marker-style = normal "#332a2f"
    plus-style = syntax "#25302b"
    plus-emph-style = syntax "#293b2c"
    plus-empty-line-marker-style = normal "#25302b"

    line-numbers-minus-style = "#e97292"
    line-numbers-plus-style = "#4cb86a"
    line-numbers-zero-style = "#7b8187"
    line-numbers-left-style = "#595e64"
    line-numbers-right-style = "#595e64"

    file-style = "#4ec983" bold
    file-decoration-style = "#595e64" ul
    hunk-header-decoration-style = "#595e64" box
    hunk-header-line-number-style = "#00b9c3"
