# Black Atom — Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#271e23"
    minus-emph-style = syntax "#3c242a"
    minus-empty-line-marker-style = normal "#271e23"
    plus-style = syntax "#18251f"
    plus-emph-style = syntax "#1e3222"
    plus-empty-line-marker-style = normal "#18251f"

    line-numbers-minus-style = "#e97292"
    line-numbers-plus-style = "#4cb86a"
    line-numbers-zero-style = "#7b8187"
    line-numbers-left-style = "#6a6f76"
    line-numbers-right-style = "#6a6f76"

    file-style = "#4ec983" bold
    file-decoration-style = "#6a6f76" ul
    hunk-header-decoration-style = "#6a6f76" box
    hunk-header-line-number-style = "#00b9c3"
