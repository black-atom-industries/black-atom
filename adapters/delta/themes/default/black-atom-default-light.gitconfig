# Black Atom — Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f6ebf2"
    minus-emph-style = syntax "#fddfe7"
    minus-empty-line-marker-style = normal "#f6ebf2"
    plus-style = syntax "#e5f2eb"
    plus-emph-style = syntax "#dbeed9"
    plus-empty-line-marker-style = normal "#e5f2eb"

    line-numbers-minus-style = "#c23870"
    line-numbers-plus-style = "#008c11"
    line-numbers-zero-style = "#43484e"
    line-numbers-left-style = "#a6aaae"
    line-numbers-right-style = "#a6aaae"

    file-style = "#009044" bold
    file-decoration-style = "#a6aaae" ul
    hunk-header-decoration-style = "#a6aaae" box
    hunk-header-line-number-style = "#00848b"
