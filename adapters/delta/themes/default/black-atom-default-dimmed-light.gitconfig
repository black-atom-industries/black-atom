# Black Atom — Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#efe1ea"
    minus-emph-style = syntax "#ffdde7"
    minus-empty-line-marker-style = normal "#efe1ea"
    plus-style = syntax "#d1e8d7"
    plus-emph-style = syntax "#c3ebc1"
    plus-empty-line-marker-style = normal "#d1e8d7"

    line-numbers-minus-style = "#c23870"
    line-numbers-plus-style = "#008c11"
    line-numbers-zero-style = "#43484e"
    line-numbers-left-style = "#a0a4a7"
    line-numbers-right-style = "#a0a4a7"

    file-style = "#009044" bold
    file-decoration-style = "#a0a4a7" ul
    hunk-header-decoration-style = "#a0a4a7" box
    hunk-header-line-number-style = "#00848b"
