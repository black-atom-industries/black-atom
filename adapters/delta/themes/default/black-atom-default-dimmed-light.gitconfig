# Black Atom — Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ebe4ea"
    minus-emph-style = syntax "#f6e2e7"
    minus-empty-line-marker-style = normal "#ebe4ea"
    plus-style = syntax "#dbe6e1"
    plus-emph-style = syntax "#d6e7d6"
    plus-empty-line-marker-style = normal "#dbe6e1"

    line-numbers-minus-style = "#fb80aa"
    line-numbers-plus-style = "#11a22f"
    line-numbers-zero-style = "#43484e"
    line-numbers-left-style = "#646a70"
    line-numbers-right-style = "#646a70"

    file-style = "#19b168" bold
    file-decoration-style = "#646a70" ul
    hunk-header-decoration-style = "#646a70" box
    hunk-header-line-number-style = "#1c989e"
