# Black Atom — Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#e6dae1"
    minus-emph-style = syntax "#ecced6"
    minus-empty-line-marker-style = normal "#e6dae1"
    plus-style = syntax "#d5e2db"
    plus-emph-style = syntax "#cadec9"
    plus-empty-line-marker-style = normal "#d5e2db"

    line-numbers-minus-style = "#c23870"
    line-numbers-plus-style = "#008c11"
    line-numbers-zero-style = "#43484e"
    line-numbers-left-style = "#a0a4a7"
    line-numbers-right-style = "#a0a4a7"

    file-style = "#009044" bold
    file-decoration-style = "#a0a4a7" ul
    hunk-header-decoration-style = "#a0a4a7" box
    hunk-header-line-number-style = "#00848b"
