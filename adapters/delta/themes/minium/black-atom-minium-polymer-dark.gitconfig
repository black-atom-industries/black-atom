# Black Atom — Minium ∷ Polymer Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#413236"
    minus-emph-style = syntax "#643f3f"
    minus-empty-line-marker-style = normal "#413236"
    plus-style = syntax "#373e37"
    plus-emph-style = syntax "#505640"
    plus-empty-line-marker-style = normal "#373e37"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#7e7974"
    line-numbers-left-style = "#645f5e"
    line-numbers-right-style = "#645f5e"

    file-style = "#ff8b37" bold
    file-decoration-style = "#645f5e" ul
    hunk-header-decoration-style = "#645f5e" box
    hunk-header-line-number-style = "#79b5cc"
