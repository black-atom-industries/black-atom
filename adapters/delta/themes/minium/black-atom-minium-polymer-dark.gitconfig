# Black Atom — Minium ∷ Polymer Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#271719"
    minus-emph-style = syntax "#4b2829"
    minus-empty-line-marker-style = normal "#271719"
    plus-style = syntax "#1e2319"
    plus-emph-style = syntax "#393f29"
    plus-empty-line-marker-style = normal "#1e2319"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#868e90"
    line-numbers-left-style = "#747c7e"
    line-numbers-right-style = "#747c7e"

    file-style = "#fc8e06" bold
    file-decoration-style = "#747c7e" ul
    hunk-header-decoration-style = "#747c7e" box
    hunk-header-line-number-style = "#79b5cc"
