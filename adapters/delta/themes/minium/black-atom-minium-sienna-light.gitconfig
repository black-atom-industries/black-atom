# Black Atom — Minium ∷ Sienna Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f4d8cd"
    minus-emph-style = syntax "#f8ccc7"
    minus-empty-line-marker-style = normal "#f4d8cd"
    plus-style = syntax "#e1e0ca"
    plus-emph-style = syntax "#d3ddc0"
    plus-empty-line-marker-style = normal "#e1e0ca"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#666261"
    line-numbers-left-style = "#a39d98"
    line-numbers-right-style = "#a39d98"

    file-style = "#ff2e00" bold
    file-decoration-style = "#a39d98" ul
    hunk-header-decoration-style = "#a39d98" box
    hunk-header-line-number-style = "#00a3e9"
