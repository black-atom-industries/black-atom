# Black Atom — Minium ∷ Sienna Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f6e1da"
    minus-emph-style = syntax "#ffdeda"
    minus-empty-line-marker-style = normal "#f6e1da"
    plus-style = syntax "#e0e5c7"
    plus-emph-style = syntax "#d4e7b4"
    plus-empty-line-marker-style = normal "#e0e5c7"

    line-numbers-minus-style = "#db0017"
    line-numbers-plus-style = "#638000"
    line-numbers-zero-style = "#676261"
    line-numbers-left-style = "#a49c9a"
    line-numbers-right-style = "#a49c9a"

    file-style = "#ff7b26" bold
    file-decoration-style = "#a49c9a" ul
    hunk-header-decoration-style = "#a49c9a" box
    hunk-header-line-number-style = "#0073c7"
