# Black Atom — Minium ∷ Sienna Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#3d2d2d"
    minus-emph-style = syntax "#4b3333"
    minus-empty-line-marker-style = normal "#3d2d2d"
    plus-style = syntax "#333228"
    plus-emph-style = syntax "#383d29"
    plus-empty-line-marker-style = normal "#333228"

    line-numbers-minus-style = "#f47a7d"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#857f7a"
    line-numbers-left-style = "#5b5352"
    line-numbers-right-style = "#5b5352"

    file-style = "#ef9369" bold
    file-decoration-style = "#5b5352" ul
    hunk-header-decoration-style = "#5b5352" box
    hunk-header-line-number-style = "#79b5cc"
