# Black Atom — Minium ∷ Sienna Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#453231"
    minus-emph-style = syntax "#5c3c3c"
    minus-empty-line-marker-style = normal "#453231"
    plus-style = syntax "#3b3931"
    plus-emph-style = syntax "#474b3b"
    plus-empty-line-marker-style = normal "#3b3931"

    line-numbers-minus-style = "#f47a7d"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#857f7a"
    line-numbers-left-style = "#69615f"
    line-numbers-right-style = "#69615f"

    file-style = "#ef9369" bold
    file-decoration-style = "#69615f" ul
    hunk-header-decoration-style = "#69615f" box
    hunk-header-line-number-style = "#79b5cc"
