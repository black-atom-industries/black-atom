# Black Atom — Minium ∷ Polymer Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#fae7e6"
    minus-emph-style = syntax "#ffd5d1"
    minus-empty-line-marker-style = normal "#fae7e6"
    plus-style = syntax "#e9f0e3"
    plus-emph-style = syntax "#dde6ca"
    plus-empty-line-marker-style = normal "#e9f0e3"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#585f61"
    line-numbers-left-style = "#868e90"
    line-numbers-right-style = "#868e90"

    file-style = "#fc8e06" bold
    file-decoration-style = "#868e90" ul
    hunk-header-decoration-style = "#868e90" box
    hunk-header-line-number-style = "#00a3e9"
