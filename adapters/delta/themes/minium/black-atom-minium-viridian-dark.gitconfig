# Black Atom — Minium ∷ Viridian Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#3b403d"
    minus-emph-style = syntax "#623f3f"
    minus-empty-line-marker-style = normal "#3b403d"
    plus-style = syntax "#2d4735"
    plus-emph-style = syntax "#464e2f"
    plus-empty-line-marker-style = normal "#2d4735"

    line-numbers-minus-style = "#f47a7d"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#67b5a9"
    line-numbers-left-style = "#308176"
    line-numbers-right-style = "#308176"

    file-style = "#e69173" bold
    file-decoration-style = "#308176" ul
    hunk-header-decoration-style = "#308176" box
    hunk-header-line-number-style = "#79b5cc"
