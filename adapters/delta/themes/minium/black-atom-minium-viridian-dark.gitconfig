# Black Atom — Minium ∷ Viridian Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#45453f"
    minus-emph-style = syntax "#704a4a"
    minus-empty-line-marker-style = normal "#45453f"
    plus-style = syntax "#3b5140"
    plus-emph-style = syntax "#5c624b"
    plus-empty-line-marker-style = normal "#3b5140"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#6fb59d"
    line-numbers-left-style = "#569c85"
    line-numbers-right-style = "#569c85"

    file-style = "#ed9562" bold
    file-decoration-style = "#569c85" ul
    hunk-header-decoration-style = "#569c85" box
    hunk-header-line-number-style = "#79b5cc"
