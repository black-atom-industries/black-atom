# Black Atom — Minium ∷ Viridian Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#424542"
    minus-emph-style = syntax "#704a4a"
    minus-empty-line-marker-style = normal "#424542"
    plus-style = syntax "#385143"
    plus-emph-style = syntax "#5c624b"
    plus-empty-line-marker-style = normal "#385143"

    line-numbers-minus-style = "#dd7577"
    line-numbers-plus-style = "#a9ba78"
    line-numbers-zero-style = "#67b5a9"
    line-numbers-left-style = "#4d9c91"
    line-numbers-right-style = "#4d9c91"

    file-style = "#e69173" bold
    file-decoration-style = "#4d9c91" ul
    hunk-header-decoration-style = "#4d9c91" box
    hunk-header-line-number-style = "#79b5cc"
