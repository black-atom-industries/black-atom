# Black Atom — Minium ∷ Viridian Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ede1db"
    minus-emph-style = syntax "#fdd1cc"
    minus-empty-line-marker-style = normal "#ede1db"
    plus-style = syntax "#dbead7"
    plus-emph-style = syntax "#d9e2c5"
    plus-empty-line-marker-style = normal "#dbead7"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#3a816a"
    line-numbers-left-style = "#6fb59d"
    line-numbers-right-style = "#6fb59d"

    file-style = "#e95e00" bold
    file-decoration-style = "#6fb59d" ul
    hunk-header-decoration-style = "#6fb59d" box
    hunk-header-line-number-style = "#00a3e9"
