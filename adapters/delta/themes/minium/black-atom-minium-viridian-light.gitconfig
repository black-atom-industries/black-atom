# Black Atom — Minium ∷ Viridian Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ece1dd"
    minus-emph-style = syntax "#fdd1cc"
    minus-empty-line-marker-style = normal "#ece1dd"
    plus-style = syntax "#daead9"
    plus-emph-style = syntax "#d9e2c5"
    plus-empty-line-marker-style = normal "#daead9"

    line-numbers-minus-style = "#f14d4c"
    line-numbers-plus-style = "#819e00"
    line-numbers-zero-style = "#308176"
    line-numbers-left-style = "#67b5a9"
    line-numbers-right-style = "#67b5a9"

    file-style = "#ee560c" bold
    file-decoration-style = "#67b5a9" ul
    hunk-header-decoration-style = "#67b5a9" box
    hunk-header-line-number-style = "#00a3e9"
