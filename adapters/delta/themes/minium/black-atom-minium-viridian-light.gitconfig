# Black Atom — Minium ∷ Viridian Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#ede8e4"
    minus-emph-style = syntax "#ffdeda"
    minus-empty-line-marker-style = normal "#ede8e4"
    plus-style = syntax "#d7ecd1"
    plus-emph-style = syntax "#d4e7b4"
    plus-empty-line-marker-style = normal "#d7ecd1"

    line-numbers-minus-style = "#db0017"
    line-numbers-plus-style = "#638000"
    line-numbers-zero-style = "#308176"
    line-numbers-left-style = "#67b5a9"
    line-numbers-right-style = "#67b5a9"

    file-style = "#ee560c" bold
    file-decoration-style = "#67b5a9" ul
    hunk-header-decoration-style = "#67b5a9" box
    hunk-header-line-number-style = "#0073c7"
