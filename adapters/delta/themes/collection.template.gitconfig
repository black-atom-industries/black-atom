<%
function mix(a, b, weight) {
  const channel = (hex, i) => parseInt(hex.slice(i, i + 2), 16);
  return "#" + [1, 3, 5].map((i) =>
    Math.round(channel(a, i) * weight + channel(b, i) * (1 - weight)).toString(16).padStart(2, "0")
  ).join("");
}

const minusBg = mix(theme.ui.bg.delete, theme.ui.bg.default, 0.5);
const plusBg = mix(theme.ui.bg.add, theme.ui.bg.default, 0.5);
_%>
# <%= theme.meta.label %>
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    <%= theme.meta.appearance %> = true
    syntax-theme = ansi

    minus-style = syntax "<%= minusBg %>"
    minus-emph-style = syntax "<%= theme.ui.bg.delete %>"
    minus-empty-line-marker-style = normal "<%= minusBg %>"
    plus-style = syntax "<%= plusBg %>"
    plus-emph-style = syntax "<%= theme.ui.bg.add %>"
    plus-empty-line-marker-style = normal "<%= plusBg %>"

    line-numbers-minus-style = "<%= theme.ui.fg.delete %>"
    line-numbers-plus-style = "<%= theme.ui.fg.add %>"
    line-numbers-zero-style = "<%= theme.ui.fg.subtle %>"
    line-numbers-left-style = "<%= theme.ui.fg.disabled %>"
    line-numbers-right-style = "<%= theme.ui.fg.disabled %>"

    file-style = "<%= theme.ui.fg.accent %>" bold
    file-decoration-style = "<%= theme.ui.fg.disabled %>" ul
    hunk-header-decoration-style = "<%= theme.ui.fg.disabled %>" box
    hunk-header-line-number-style = "<%= theme.ui.fg.info %>"
