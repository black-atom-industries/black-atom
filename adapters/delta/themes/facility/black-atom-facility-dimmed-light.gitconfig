# Black Atom — Facility ∷ Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#e9dce1"
    minus-emph-style = syntax "#eac7d0"
    minus-empty-line-marker-style = normal "#e9dce1"
    plus-style = syntax "#d6e4da"
    plus-emph-style = syntax "#c4d8c2"
    plus-empty-line-marker-style = normal "#d6e4da"

    line-numbers-minus-style = "#cb4c7c"
    line-numbers-plus-style = "#3f9640"
    line-numbers-zero-style = "#839091"
    line-numbers-left-style = "#8e9b9d"
    line-numbers-right-style = "#8e9b9d"

    file-style = "#b2cd0d" bold
    file-decoration-style = "#8e9b9d" ul
    hunk-header-decoration-style = "#8e9b9d" box
    hunk-header-line-number-style = "#5a6465"
