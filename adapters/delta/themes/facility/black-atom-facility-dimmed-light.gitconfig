# Black Atom — Facility ∷ Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f4e7ed"
    minus-emph-style = syntax "#ffdde7"
    minus-empty-line-marker-style = normal "#f4e7ed"
    plus-style = syntax "#d6eeda"
    plus-emph-style = syntax "#c3ebc1"
    plus-empty-line-marker-style = normal "#d6eeda"

    line-numbers-minus-style = "#bb316b"
    line-numbers-plus-style = "#097916"
    line-numbers-zero-style = "#4b5b5d"
    line-numbers-left-style = "#8e9b9d"
    line-numbers-right-style = "#8e9b9d"

    file-style = "#b2cd0d" bold
    file-decoration-style = "#8e9b9d" ul
    hunk-header-decoration-style = "#8e9b9d" box
    hunk-header-line-number-style = "#475253"
