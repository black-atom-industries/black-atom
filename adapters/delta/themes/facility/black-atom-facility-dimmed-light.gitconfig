# Black Atom — Facility ∷ Dimmed Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#eadce0"
    minus-emph-style = syntax "#eac7d0"
    minus-empty-line-marker-style = normal "#eadce0"
    plus-style = syntax "#d7e4d9"
    plus-emph-style = syntax "#c4d8c2"
    plus-empty-line-marker-style = normal "#d7e4d9"

    line-numbers-minus-style = "#cb4c7c"
    line-numbers-plus-style = "#3f9640"
    line-numbers-zero-style = "#669a84"
    line-numbers-left-style = "#77a494"
    line-numbers-right-style = "#77a494"

    file-style = "#a8ba33" bold
    file-decoration-style = "#77a494" ul
    hunk-header-decoration-style = "#77a494" box
    hunk-header-line-number-style = "#476a5f"
