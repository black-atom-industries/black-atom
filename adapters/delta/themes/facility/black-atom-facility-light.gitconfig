# Black Atom — Facility ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f5e4e9"
    minus-emph-style = syntax "#f2cfd8"
    minus-empty-line-marker-style = normal "#f5e4e9"
    plus-style = syntax "#e2ede2"
    plus-emph-style = syntax "#cce0ca"
    plus-empty-line-marker-style = normal "#e2ede2"

    line-numbers-minus-style = "#cb4c7c"
    line-numbers-plus-style = "#3f9640"
    line-numbers-zero-style = "#75a490"
    line-numbers-left-style = "#95b8ac"
    line-numbers-right-style = "#95b8ac"

    file-style = "#a8ba33" bold
    file-decoration-style = "#95b8ac" ul
    hunk-header-decoration-style = "#95b8ac" box
    hunk-header-line-number-style = "#51796d"
