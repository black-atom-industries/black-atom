# Black Atom — Facility ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f9ecf2"
    minus-emph-style = syntax "#ffdde7"
    minus-empty-line-marker-style = normal "#f9ecf2"
    plus-style = syntax "#dbf3df"
    plus-emph-style = syntax "#c3ebc1"
    plus-empty-line-marker-style = normal "#dbf3df"

    line-numbers-minus-style = "#bb316b"
    line-numbers-plus-style = "#097916"
    line-numbers-zero-style = "#566769"
    line-numbers-left-style = "#a5b2b3"
    line-numbers-right-style = "#a5b2b3"

    file-style = "#b2cd0d" bold
    file-decoration-style = "#a5b2b3" ul
    hunk-header-decoration-style = "#a5b2b3" box
    hunk-header-line-number-style = "#525d5e"
