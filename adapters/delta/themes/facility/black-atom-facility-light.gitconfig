# Black Atom — Facility ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#f2e4eb"
    minus-emph-style = syntax "#f2ced8"
    minus-empty-line-marker-style = normal "#f2e4eb"
    plus-style = syntax "#dfede4"
    plus-emph-style = syntax "#cbe0ca"
    plus-empty-line-marker-style = normal "#dfede4"

    line-numbers-minus-style = "#cb4c7c"
    line-numbers-plus-style = "#3f9640"
    line-numbers-zero-style = "#8e9b9c"
    line-numbers-left-style = "#a5b2b3"
    line-numbers-right-style = "#a5b2b3"

    file-style = "#b2cd0d" bold
    file-decoration-style = "#a5b2b3" ul
    hunk-header-decoration-style = "#a5b2b3" box
    hunk-header-line-number-style = "#687273"
