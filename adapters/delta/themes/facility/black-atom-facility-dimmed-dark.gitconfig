# Black Atom — Facility ∷ Dimmed Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#2d252b"
    minus-emph-style = syntax "#3e2933"
    minus-empty-line-marker-style = normal "#2d252b"
    plus-style = syntax "#212b24"
    plus-emph-style = syntax "#253525"
    plus-empty-line-marker-style = normal "#212b24"

    line-numbers-minus-style = "#ffa9d2"
    line-numbers-plus-style = "#96e497"
    line-numbers-zero-style = "#a7b4b6"
    line-numbers-left-style = "#4d5354"
    line-numbers-right-style = "#4d5354"

    file-style = "#ddfa5f" bold
    file-decoration-style = "#4d5354" ul
    hunk-header-decoration-style = "#4d5354" box
    hunk-header-line-number-style = "#cfd9dc"
