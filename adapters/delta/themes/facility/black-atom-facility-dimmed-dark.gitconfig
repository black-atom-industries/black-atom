# Black Atom — Facility ∷ Dimmed Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#463941"
    minus-emph-style = syntax "#705260"
    minus-empty-line-marker-style = normal "#463941"
    plus-style = syntax "#344437"
    plus-emph-style = syntax "#4c674c"
    plus-empty-line-marker-style = normal "#344437"

    line-numbers-minus-style = "#ffa9d2"
    line-numbers-plus-style = "#96e497"
    line-numbers-zero-style = "#a7b4b6"
    line-numbers-left-style = "#8e9b9c"
    line-numbers-right-style = "#8e9b9c"

    file-style = "#ddfa5f" bold
    file-decoration-style = "#8e9b9c" ul
    hunk-header-decoration-style = "#8e9b9c" box
    hunk-header-line-number-style = "#cfd9dc"
