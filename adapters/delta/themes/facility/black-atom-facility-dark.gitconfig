# Black Atom — Facility ∷ Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#1d141a"
    minus-emph-style = syntax "#2c1822"
    minus-empty-line-marker-style = normal "#1d141a"
    plus-style = syntax "#111a14"
    plus-emph-style = syntax "#152415"
    plus-empty-line-marker-style = normal "#111a14"

    line-numbers-minus-style = "#ffa9d2"
    line-numbers-plus-style = "#96e497"
    line-numbers-zero-style = "#a7b4b6"
    line-numbers-left-style = "#464c4d"
    line-numbers-right-style = "#464c4d"

    file-style = "#ddfa5f" bold
    file-decoration-style = "#464c4d" ul
    hunk-header-decoration-style = "#464c4d" box
    hunk-header-line-number-style = "#dae4e7"
