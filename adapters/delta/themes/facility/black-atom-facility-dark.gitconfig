# Black Atom — Facility ∷ Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#382c32"
    minus-emph-style = syntax "#644754"
    minus-empty-line-marker-style = normal "#382c32"
    plus-style = syntax "#273529"
    plus-emph-style = syntax "#415a41"
    plus-empty-line-marker-style = normal "#273529"

    line-numbers-minus-style = "#ffa9d2"
    line-numbers-plus-style = "#96e497"
    line-numbers-zero-style = "#91bcad"
    line-numbers-left-style = "#75a490"
    line-numbers-right-style = "#75a490"

    file-style = "#e7fc7c" bold
    file-decoration-style = "#75a490" ul
    hunk-header-decoration-style = "#75a490" box
    hunk-header-line-number-style = "#c3eed9"
