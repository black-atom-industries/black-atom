# Black Atom — TR-1000 ∷ Dark
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    dark = true
    syntax-theme = ansi

    minus-style = syntax "#362729"
    minus-emph-style = syntax "#4f3030"
    minus-empty-line-marker-style = normal "#362729"
    plus-style = syntax "#28302a"
    plus-emph-style = syntax "#334333"
    plus-empty-line-marker-style = normal "#28302a"

    line-numbers-minus-style = "#fa676c"
    line-numbers-plus-style = "#79c77c"
    line-numbers-zero-style = "#9198a8"
    line-numbers-left-style = "#4c515b"
    line-numbers-right-style = "#4c515b"

    file-style = "#8fadee" bold
    file-decoration-style = "#4c515b" ul
    hunk-header-decoration-style = "#4c515b" box
    hunk-header-line-number-style = "#63bfe1"
