# Black Atom — TR-1000 ∷ Light
# Generated by Black Atom Industries — https://github.com/black-atom-industries/black-atom
[delta]
    light = true
    syntax-theme = ansi

    minus-style = syntax "#eadbde"
    minus-emph-style = syntax "#ffdedc"
    minus-empty-line-marker-style = normal "#eadbde"
    plus-style = syntax "#cbe1d1"
    plus-emph-style = syntax "#c2ebc2"
    plus-empty-line-marker-style = normal "#cbe1d1"

    line-numbers-minus-style = "#b0072a"
    line-numbers-plus-style = "#1a6323"
    line-numbers-zero-style = "#626978"
    line-numbers-left-style = "#8b92a2"
    line-numbers-right-style = "#8b92a2"

    file-style = "#00739a" bold
    file-decoration-style = "#8b92a2" ul
    hunk-header-decoration-style = "#8b92a2" box
    hunk-header-line-number-style = "#005c83"
