{
    "$schema": "./node_modules/oxfmt/configuration_schema.json",
    "printWidth": 100,
    "tabWidth": 4,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "sortPackageJson": false,
    "ignorePatterns": [
        ".pi/",
        "target/",
        "PLAN.md",
        "package-lock.json",
        "**/CHANGELOG.md",
        ".github/.release-please-manifest.json",
        "core/monitor/src/routeTree.gen.ts",
        "livery/src/routeTree.gen.ts",
        "livery/src/bindings.ts",
        "livery/core/",
        "livery/cli/",
        "livery/src-tauri/",
        "livery/docs/design-system/reference/",
        "livery/e2e/fixtures/",
        "livery/e2e/playwright-report/",
        "livery/e2e/test-results/",
        "adapters/*/themes/",
        "adapters/kagi/fragments/",
        "adapters/kagi/styles/base.css",
        "adapters/nvim/lua/black-atom/themes/",
        "adapters/nvim/colors/",
        "adapters/nvim/syntax_examples/",
        "adapters/obsidian/theme.css",
        "**/.claude/",
        "**/.agents/",
        "**/.impeccable/"
    ]
}
