{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "packages": {
        ".": {
            "release-type": "simple",
            "bump-minor-pre-major": true,
            "bump-patch-for-minor-pre-major": false,
            "include-component-in-tag": false,
            "skip-changelog": true,
            "changelog-sections": [
                { "type": "feat", "section": "Features" },
                { "type": "refactor", "section": "Refactors" },
                { "type": "fix", "section": "Bug Fixes" },
                { "type": "docs", "section": "Documentation" },
                { "type": "perf", "section": "Performance" }
            ],
            "extra-files": [
                { "type": "json", "path": "core/package.json", "jsonpath": "$.version" },
                { "type": "json", "path": "livery/package.json", "jsonpath": "$.version" },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.core.version"
                },
                {
                    "type": "json",
                    "path": "package-lock.json",
                    "jsonpath": "$.packages.livery.version"
                },
                {
                    "type": "toml",
                    "path": "livery/src-tauri/Cargo.toml",
                    "jsonpath": "$.package.version"
                },
                {
                    "type": "toml",
                    "path": "livery/core/Cargo.toml",
                    "jsonpath": "$.package.version"
                },
                {
                    "type": "toml",
                    "path": "livery/cli/Cargo.toml",
                    "jsonpath": "$.package.version"
                },
                {
                    "type": "json",
                    "path": "livery/src-tauri/tauri.conf.json",
                    "jsonpath": "$.version"
                }
            ]
        }
    }
}
