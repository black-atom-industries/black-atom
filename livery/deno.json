{
    "version": "0.6.0",
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "react",
        "jsxImportSourceTypes": "@types/react",
        "types": [
            "npm:vite/client"
        ],
        "lib": [
            "deno.ns",
            "dom",
            "dom.iterable"
        ]
    },
    "tasks": {
        "cache": "deno cache --reload src/",
        "dev": "deno run -A npm:@tauri-apps/cli dev",
        "airship": "deno run -A scripts/airship.ts",
        "build": "deno run -A npm:@tauri-apps/cli build",
        "vite:dev": "deno run -A npm:vite --port 1420",
        "vite:build": "deno run -A npm:vite build",
        "check": "deno check src/",
        "test": "deno test -P",
        "test:perf-benchmark": "cd src-tauri && cargo run --bin perf-benchmark --release",
        "install:macos": "deno run -A npm:@tauri-apps/cli build && rm -rf /Applications/livery.app && cp -R ../target/release/bundle/macos/livery.app /Applications/livery.app",
        "dev:ui": "deno run -A npm:vite --port 1430 --open '/dev'"
    },
    "test": {
        "permissions": {
            "env": true,
            "read": true,
            "write": true
        }
    },
    "imports": {
        "@/": "./src/",
        "@base-ui/react": "npm:@base-ui/react@^1",
        "cva": "npm:cva@^1.0.0-beta.4",
        "clsx": "npm:clsx@^2.1.1",
        "culori": "npm:culori@4",
        "@deno/vite-plugin": "npm:@deno/vite-plugin@^1",
        "@fontsource/ibm-plex-sans": "npm:@fontsource/ibm-plex-sans@^5",
        "@fontsource/iosevka": "npm:@fontsource/iosevka@^5",
        "@fontsource/space-grotesk": "npm:@fontsource/space-grotesk@^5",
        "@std/assert": "jsr:@std/assert@^1.0.0",
        "@std/path": "jsr:@std/path@^1.0.0",
        "@tanstack/store": "npm:@tanstack/store@^0.9",
        "@tanstack/react-store": "npm:@tanstack/react-store@^0.9",
        "@tanstack/react-query": "npm:@tanstack/react-query@^5",
        "@tanstack/react-router": "npm:@tanstack/react-router@^1",
        "@tanstack/router-plugin": "npm:@tanstack/router-plugin@^1",
        "@tanstack/react-devtools": "npm:@tanstack/react-devtools@^0",
        "@tanstack/react-query-devtools": "npm:@tanstack/react-query-devtools@^5",
        "@tanstack/react-router-devtools": "npm:@tanstack/react-router-devtools@^1",
        "@tanstack/react-hotkeys": "npm:@tanstack/react-hotkeys@^0.3.0",
        "react": "npm:react@^19",
        "@types/react": "npm:@types/react@^19",
        "react-dom": "npm:react-dom@^19",
        "@types/react-dom": "npm:@types/react-dom@^19",
        "vite": "npm:vite@^6",
        "@vitejs/plugin-react": "npm:@vitejs/plugin-react@^4",
        "@tauri-apps/api": "npm:@tauri-apps/api@~2.11.0",
        "@tauri-apps/cli": "npm:@tauri-apps/cli@~2.11.0",
        "@tauri-apps/plugin-opener": "npm:@tauri-apps/plugin-opener@^2",
        "@tauri-apps/plugin-dialog": "npm:@tauri-apps/plugin-dialog@^2"
    }
}
