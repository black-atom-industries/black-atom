{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": ["src/routes/**/*.tsx", "src/components/*/index.ts", "src/partials/*/index.ts"],
    "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}"],
    "ignoreDependencies": ["@fontsource/chakra-petch", "@fontsource/kode-mono"],
    "playwright": {
        "config": ["playwright.config.ts"],
        "entry": ["e2e/**/*.spec.ts"]
    }
}
