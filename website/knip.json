{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "entry": ["src/routes/**/*.tsx"],
    "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.{ts,tsx}"],
    "ignoreDependencies": [
        "@fontsource/chakra-petch",
        "@fontsource/kode-mono",
        "@base-ui/react",
        "@black-atom/core",
        "@tanstack/react-store",
        "@vercel/analytics",
        "cva",
        "three",
        "tone",
        "zod",
        "@playwright/test"
    ],
    "playwright": {
        "config": ["playwright.config.ts"],
        "entry": ["e2e/**/*.spec.ts"]
    }
}
